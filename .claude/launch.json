        "127.0.0.1",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "url": "http://127.0.0.1:4173"
    },
    {
      "name": "ghpages",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--base",
        "/trenirovka/",
        "--host",
        "127.0.0.1",
        "--port",
        "4175",
        "--strictPort"
      ],
      "port": 4175,
